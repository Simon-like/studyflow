# ==========================================
# StudyFlow Web 开发环境配置
# ==========================================

# API 基础地址
# 留空 = 请求发到自身（localhost:5180），由 Vite proxy 转发到本地后端，绕过 CORS
# 浏览器 Network 面板看到的是 localhost:5180/tasks/today，这是正常的
VITE_API_BASE_URL=

# Vite 反向代理目标（供 vite.config.ts 读取）
VITE_PROXY_TARGET=http://localhost:8080

# 是否使用 Mock 数据
VITE_USE_MOCK=false

# 应用信息
VITE_APP_NAME=StudyFlow
VITE_APP_VERSION=1.0.0
